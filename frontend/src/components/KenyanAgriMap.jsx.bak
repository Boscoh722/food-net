import { MapContainer, TileLayer, Marker, Popup, Circle } from 'react-leaflet';
import 'leaflet/dist/leaflet.css';

const agriculturalZones = [
  {
    name: 'Nairobi',
    position: [-1.2921, 36.8219],
    description: 'Central Distribution Hub',
    radius: 50000,
    color: 'green'
  },
  {
    name: 'Eldoret',
    position: [0.5143, 35.2698],
    description: 'Grain Farming Region',
    radius: 70000,
    color: 'yellow'
  },
  {
    name: 'Nakuru',
    position: [-0.3031, 36.0800],
    description: 'Mixed Farming Zone',
    radius: 45000,
    color: 'blue'
  },
  {
    name: 'Kisumu',
    position: [-0.0917, 34.7680],
    description: 'Lake Region Agriculture',
    radius: 40000,
    color: 'purple'
  },
  {
    name: 'Mombasa',
    position: [-4.0435, 39.6682],
    description: 'Coastal Agriculture',
    radius: 60000,
    color: 'orange'
  },
  {
    name: 'Machakos',
    position: [-1.5222, 37.2614],
    description: 'Eastern Region Farming',
    radius: 45000,
    color: 'red'
  }
];

export default function KenyanAgriMap() {
  return (
    <MapContainer
      center={[-1.2921, 36.8219]} 
      zoom={7}
      className="h-full w-full z-0"
    >
      <TileLayer
        url="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
        attribution='&copy; OpenStreetMap contributors'
      />
      
      {agriculturalZones.map((zone) => (
        <div key={zone.name}>
          <Marker position={zone.position}>
            <Popup>
              <div className="font-semibold">{zone.name}</div>
              <div className="text-sm text-gray-600">{zone.description}</div>
            </Popup>
          </Marker>
          <Circle
            center={zone.position}
            radius={zone.radius}
            pathOptions={{
              color: zone.color,
              fillColor: zone.color,
              fillOpacity: 0.2
            }}
          >
            <Popup>
              <div className="font-semibold">{zone.name} Agricultural Zone</div>
              <div className="text-sm text-gray-600">Major farming region</div>
            </Popup>
          </Circle>
        </div>
      ))}
    </MapContainer>
  );
}
